# =============================================================================
# RetailFix CRM Backend - Environment Configuration Template
# =============================================================================

# Database Configuration (PostgreSQL only)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Authentication & JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=https://retailfix-crm.vercel.app,https://retailfix-crm-git-main-jayyede93-7431s-projects.vercel.app

# Server Environment
PORT=8001
ENV=production
DEBUG=False
